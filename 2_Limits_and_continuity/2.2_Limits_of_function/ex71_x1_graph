#!/usr/bin/env gnuplot

set terminal pngcairo size 900,650
set output "ex71_x1_graph.png"

f(x) = (x == 1 ? 1/0 : (x**2 - 1) / (abs(x) - 1))

set title "f(x) = (x^2 - 1) / (abs(x) - 1) near x = 1"
set xlabel "x"
set ylabel "f(x)"
set xrange [0.9:1.1]
set yrange [1.89:2.11]
set sample 1000
set grid
set arrow nohead from 1,1.89 to 1,2.11 dt 2 lc rgb "red"
set label "x = 1" at 1.005,2.1 left tc rgb "red"

plot f(x) with lines lw 2 title "f(x)", \
     "-" using 1:2 with points pt 6 ps 0.8 lc rgb "red" title "limit point"
1 2

e
