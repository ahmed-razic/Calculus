set terminal qt

f(x) = (x == -3 ? 1/0 : (x**2 - 9)/(x + 3))

set title "f(x) = (x^2 - 9)/(x + 3) near x = -3"
set xlabel "x"
set ylabel "f(x)"
set xrange [-3.0001:-2.9999]
set yrange [-6.0002:-5.9998]
set sample 1000
set grid
set arrow nohead from -3,-6.0002 to -3,-5.9998 dt 2 lc rgb "red"
set label "x = -3" at -3,-5.99982 center tc rgb "red"

plot f(x) with lines lw 2 title "f(x)", \
     "-" using 1:2 with points pt 6 ps 0.8 lc rgb "red" notitle
-3 -6

e
pause -1
