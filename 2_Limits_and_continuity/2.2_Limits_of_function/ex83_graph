#!/usr/bin/env gnuplot

set terminal pngcairo size 1000,700
set output "ex83_graph.png"

f(x) = (x == 0 ? 1/0 : x**2 * sin(1 / x**3))
upper_envelope(x) = x**2
lower_envelope(x) = -x**2

set title "g(x) = x^2 sin(1/x^3) near x = 0"
set xlabel "x"
set ylabel "g(x)"
set xrange [-2:2]
set yrange [-4.2:4.2]
set samples 2000
set grid
set arrow nohead from 0,-4.2 to 0,4.2 dt 2 lc rgb "red"
set arrow nohead from -2,0 to 2,0 dt 2 lc rgb "black"
set label "x = 0" at 0.04,3.85 left tc rgb "red"

plot f(x) with lines lw 1.2 lc rgb "steelblue" title "g(x)", \
     upper_envelope(x) with lines dt 2 lw 1.5 lc rgb "dark-green" title "y = x^2", \
     lower_envelope(x) with lines dt 2 lw 1.5 lc rgb "dark-green" title "y = -x^2", \
     "-" using 1:2 with points pt 6 ps 0.8 lc rgb "red" title "limit point"
0 0

e
