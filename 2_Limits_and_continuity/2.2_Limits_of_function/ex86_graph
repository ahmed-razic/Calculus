#!/usr/bin/env gnuplot

set terminal pngcairo size 1000,700
set output "ex86_graph.png"

f(x) = (x == -1 ? 1/0 : (x**3 - x**2 - 5*x - 3) / ((x + 1)**2))

set title "f(x) = (x^3 - x^2 - 5x - 3) / (x + 1)^2"
set xlabel "x"
set ylabel "f(x)"
set xrange [-3:2]
set yrange [-6:0]
set samples 2000
set grid
set arrow nohead from -1,-6 to -1,0 dt 2 lc rgb "red"
set label "x = -1" at -0.92,-0.35 left tc rgb "red"

plot f(x) with lines lw 2 lc rgb "steelblue" title "f(x)", \
     "-" using 1:2 with points pt 6 ps 1.2 lc rgb "red" title "hole at (-1,-4)"
-1 -4

e
