#!/usr/bin/env gnuplot

set terminal pngcairo size 1000,700
set output "ex85_graph.png"

f(x) = (x == 2 ? 1/0 : (x**4 - 16) / (x - 2))

set title "f(x) = (x^4 - 16) / (x - 2)"
set xlabel "x"
set ylabel "f(x)"
set xrange [0:4]
set yrange [0:125]
set samples 2000
set grid
set arrow nohead from 2,0 to 2,125 dt 2 lc rgb "red"
set label "x = 2" at 2.04,118 left tc rgb "red"

plot f(x) with lines lw 2 lc rgb "steelblue" title "f(x)", \
     "-" using 1:2 with points pt 6 ps 1.2 lc rgb "red" title "hole at (2,32)"
2 32

e
