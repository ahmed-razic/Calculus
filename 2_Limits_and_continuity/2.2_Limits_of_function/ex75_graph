#!/usr/bin/env gnuplot

set terminal pngcairo size 900,650
set output "ex75_graph.png"

f(x) = (x == 1 ? 1/0 : x**(1 / (1 - x)))

set title "f(x) = x**(1 / (1 - x)) near x = 1"
set xlabel "x"
set ylabel "f(x)"
set xrange [0.9:1.1]
set yrange [0.36:0.376]
set sample 1000
set grid
set arrow nohead from 1,0.36 to 1,0.376 dt 2 lc rgb "red"
set label "x = 1" at 1.005,0.3745 left tc rgb "red"

plot f(x) with lines lw 2 title "f(x)", \
     "-" using 1:2 with points pt 6 ps 0.8 lc rgb "red" title "limit point"
1 0.3678794412

e
