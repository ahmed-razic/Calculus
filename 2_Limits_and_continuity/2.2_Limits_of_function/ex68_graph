set terminal qt

f(x) = (x == sqrt(2) ? 1/0 : (x**2 - 2)/(x - sqrt(2)))

set title "f(x) = (x^2 - 2) / (x - sqrt(2)) near x = sqrt(2)"
set xlabel "x"
set ylabel "f(x)"
set xrange [1.39:1.42]
set yrange [2.7:2.9]
set sample 1000
set grid
set arrow nohead from sqrt(2),2.7 to sqrt(2),2.9 dt 2 lc rgb "red"
set label "x = sqrt(2)" at sqrt(2)+0.001, 2*sqrt(2)+0.015 left tc rgb "red"

plot f(x) with lines lw 2 title "f(x)", \
     "-" using 1:2 with points pt 6 ps 0.8 lc rgb "red" notitle
1.4142135623730951 2.8284271247461903

e
pause -1