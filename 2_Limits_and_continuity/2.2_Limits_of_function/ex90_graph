#!/usr/bin/env gnuplot

set terminal pngcairo size 1000,700
set output "ex90_graph.png"

f(x) = (x == 0 ? 1/0 : (2*x**2) / (3 - 3*cos(x)))

set title "f(x) = 2x^2 / (3 - 3cos(x))"
set xlabel "x"
set ylabel "f(x)"
set xrange [-2:2]
set yrange [1.2:2.0]
set samples 2000
set grid
set arrow nohead from 0,1.2 to 0,2.0 dt 2 lc rgb "red"
set label "x = 0" at 0.04,1.94 left tc rgb "red"

plot f(x) with lines lw 2 lc rgb "steelblue" title "f(x)", \
     "-" using 1:2 with points pt 6 ps 1.2 lc rgb "red" title "hole at (0,4/3)"
0 1.3333333333

e
