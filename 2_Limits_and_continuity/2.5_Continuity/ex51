# gnuplot script for f(x) = (10^x - 1) / x on [-3, 3]

set terminal wxt

set grid
set xlabel "x"
set ylabel "f(x)"
set title "f(x) = (10^x - 1)/x"
set xrange [-3:3]
set yrange [0:4]
set samples 2000

# Leave the missing point at x = 0 undefined.
f(x) = (abs(x) < 1e-8) ? NaN : ((10**x - 1) / x)

# Draw a large open circle at the hole: (0, ln(10)).
set object 1 circle at 0, log(10) radius 0.18
set object 1 fc rgb "white" fs empty border lc rgb "red" lw 2

plot f(x) with lines lw 2 lc rgb "blue" notitle

pause -1