# gnuplot script for f(x) = (10^x - 1) / x on [-3, 3]

set terminal wxt

set grid
set xlabel "x"
set ylabel "f(x)"
set title "f(x) = (10^x - 1)/x"
set xrange [-3:3]
set yrange [0:4]
set samples 2000

# Leave the missing point at x = 0 undefined.
f(x) = (abs(x) < 1e-8) ? NaN : ((10**x - 1) / x)

# Mark the hole at (0, ln(10)) with an open circle.
plot f(x) with lines lw 2 lc rgb "blue" notitle, \
     '-' using 1:2 with points pt 7 ps 3 lc rgb "red" lw 2 notitle
0  log(10)
e

pause -1