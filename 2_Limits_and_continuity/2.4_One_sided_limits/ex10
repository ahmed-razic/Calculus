set terminal qt

f(x) = (x < -1 || x > 1 ? 0 : (x >= -1 && x < 0 ? x : (x == 1 ? 0 : 1/0)))

set title "Exercise 10"
set xlabel "x"
set ylabel "y"
set xrange [-2.5:2.5]
set yrange [-1.5:1.5]
set sample 2000
set grid

plot f(x) with lines, \
     '-' with points pt 6 ps 0.8 lc rgb "black", \
     '-' with points pt 7 ps 0.8 lc rgb "black"
0 0
e
1 0
e

pause -1