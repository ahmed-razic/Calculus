set terminal qt

f(x) = sqrt(1 - x**2)
g(x) = 1
h(x) = 2

set title "Exercise 9"
set xlabel "x"
set ylabel "y"
set yrange [-0.5:2.5]
set sample 2000
set grid
set key left top

plot [0:2.5] (x >= 0 && x < 1 ? f(x) : 1/0) with lines, \
		   (x >= 1 && x < 2 ? g(x) : 1/0) with lines, \
		   '-' with points pt 6 ps 0.8 lc rgb "black", \
		   '-' with points pt 7 ps 0.8 lc rgb "black", \
		   '-' with points pt 7 ps 0.8 lc rgb "black", \
		   '-' with points pt 6 ps 0.8 lc rgb "black"
0 0
e
1 0
e
1 1
e
2 1
e

pause -1
