set terminal qt

f(x) = (x == 0 ? 1/0 : x*sin(1/x))
g(x) = x

set title "f(x) = x sin(1/x)"
set xlabel "x"
set ylabel "f(x)"
set xrange [-2:2]
set yrange [-2:2]
set samples 5000
set grid

plot f(x) with lines lw 2 title "x sin(1/x)", \
	g(x) with lines lw 1 dt 2 lc rgb "red" title "x", \
    -g(x) with lines lw 1 dt 2 lc rgb "blue" title "-x"

pause -1