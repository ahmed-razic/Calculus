set terminal qt

f(x) = (x == 0 ? 1/0 : (x**2)*sin(1/x))
g(x) = x**2

set title "f(x) = (x^2)*sin(1/x)"
set xlabel "x"
set ylabel "f(x)"

set xrange [-1 : 1]
set yrange [-1 : 1]

set samples 5000
set grid

plot f(x) with lines lw 2 lc rgb "blue" title "(x^2)*sin(1/x)", \
    g(x) with lines lw 1 dt 2 lc rgb "red" title "x^2", \
    -g(x) with lines lw 1 dt 2 lc rgb "green" title "-x^2"

pause -1
