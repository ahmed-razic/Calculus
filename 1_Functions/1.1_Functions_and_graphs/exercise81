f(x) = x >= 0 ? sqrt(x) : 1/0
g(x) = x <= 1 ? sqrt(1 - x) : 1/0

set terminal wxt
set grid
set samples 1000
set xlabel "x"
set ylabel "y"
set xrange [-0.5:1.5]
set yrange [-1:4]

plot f(x) with lines lw 2 lc rgb "black", g(x) with lines lw 2 lc rgb "black", \
 f(x) + g(x) with lines, \
 f(x) - g(x) with lines, \
 f(x)*g(x) with lines, \
 f(x)/g(x) with lines, \
 g(x)/f(x) with lines

pause -1
