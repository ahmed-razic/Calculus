f(x) = sin(x**2)
g(x) = (sin(x))**2
h(x) = sin(x)

set terminal wxt

set xlabel "x"
set ylabel "y"
set grid
set xrange [-2*pi:2*pi]
set yrange [-2:2]

set samples 1000

plot f(x) title "f(x) = sin(x^2)" with lines, \
     g(x) title "g(x) = (sin(x))^2" with lines, \
     h(x) title "h(x) = sin(x)" with lines

pause -1